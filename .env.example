# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional: override the Gemini model (names are retired over time)
# GEMINI_MODEL=gemini-2.5-flash

# Pipeline email (Gmail App Password, not your real password)
EMAIL_SENDER=
EMAIL_APP_PASSWORD=

# Optional: show the "SQL Connection" upload option (off by default; unsafe on a public deployment)
# ENABLE_SQL_CONNECTION=1
